# All variables are optional. With none set, the app reads the default sheet.

# Where opportunities come from: "sheet" (default) or "expa" (live EXPA API).
DATA_SOURCE=sheet

# Only for DATA_SOURCE=expa. The public guest token aiesec.org's own search
# uses; copy it from aiesec.org's network requests (Authorization header).
# Put the real value in .env.local (git-ignored), never in this file.
# EXPA_TOKEN=

# EXPA committee whose open GV opportunities are listed (1623 = Sri Lanka).
EXPA_COMMITTEE_ID=1623

# Override only if EXPA's GraphQL address changes.
# EXPA_GRAPHQL_URL=https://gis-api.aiesec.org/graphql

# ID of the Google Sheet (the part between /d/ and /edit in its URL).
GOOGLE_SHEET_ID=1j6IkDXwEbCLA2Jt2YYuJcL8E2YTnYjudADOAVxirjZI

# Use instead of the default export URL, e.g. a "Publish to the web" xlsx link:
# https://docs.google.com/spreadsheets/d/e/<published-id>/pub?output=xlsx
# GOOGLE_SHEET_XLSX_URL=

# The three settings below apply to both sources (sheet or EXPA).
# Seconds a fetched copy of the data is treated as fresh (default 600).
SHEET_CACHE_SECONDS=600

# Seconds an older copy may still be served while a refresh runs or after a
# failed refresh (default 86400). After that, pages show "unavailable".
SHEET_MAX_STALE_SECONDS=86400

# Timeout for fetching the sheet, in milliseconds (default 20000).
SHEET_FETCH_TIMEOUT_MS=20000
